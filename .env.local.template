# MongoDB Bağlantı Adresi (Gerekli)
# Örnek yerel bağlantı: mongodb://localhost:27017/pisti
# Örnek bulut bağlantısı: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/pisti
MONGODB_URI=mongodb://localhost:27017/pisti

# Redis Bağlantı Adresi (İsteğe Bağlı)
# Önbellekleme yapılmak isteniyorsa aktif edilmelidir. Tanımlanmazsa cache devre dışı kalır.
# REDIS_URL=redis://localhost:6379

# NextAuth Gizli Anahtarı (Gerekli)
# Güvenlik için en az 32 karakterden oluşan rastgele bir string olmalıdır.
# Örnek oluşturmak için terminalde çalıştırabilirsiniz: openssl rand -base64 33
AUTH_SECRET=pisti-secret-key-at-least-32-characters-long-12345
